{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-schnell-fp8.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 720,
      "height": 1280,
      "batch_size": 1
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "ckpt",
        0
      ],
      "seed": 0,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "videomaker/key",
      "images": [
        "dec",
        0
      ]
    }
  }
}
